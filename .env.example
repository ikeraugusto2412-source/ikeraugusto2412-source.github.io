# Copy to .env.local (git-ignored) and fill in. For the GitHub Pages build these are set as
# repository variables (Settings › Secrets and variables › Actions › Variables).

# Final public address of the site, without a trailing slash. Enables absolute link-preview
# images (WhatsApp, Instagram, X…) plus robots.txt / sitemap.xml with the right URLs.
VITE_SITE_URL=

# Contact form: free access key from https://web3forms.com (messages go to the email you register).
# Without it, the form opens the visitor's email app instead. The key is public by design.
VITE_WEB3FORMS_KEY=

# Visit statistics: the website ID from Umami (https://cloud.umami.is › Websites › Tracking code).
# Free, no cookies. Only counts visits on the VITE_SITE_URL domain.
VITE_UMAMI_WEBSITE_ID=

# Live "viewing now · visits" pill in the footer: the id at the end of the Umami share URL
# (Umami › Websites › Edit › Share URL → cloud.umami.is/share/<id>). Read-only and
# public by design. Without it the pill is hidden.
VITE_UMAMI_SHARE_ID=

# Reel comments: a free Supabase project (https://supabase.com) with the table from
# supabase/comments.sql. Project Settings › API › Project URL and the anon public key
# (public by design; the table's rules only let visitors read and add comments).
# Without them the comment sheet says comments open soon.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
